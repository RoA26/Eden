# Copia este archivo como .env y cambia TODOS los valores.
# Genera valores aleatorios con:  openssl rand -hex 24

# Contrasena de la base de datos de produccion
DB_PASSWORD=cambia-esto

# Codigo que debe escribir quien cree una cuenta (por ejemplo, tu papa)
APP_CODIGO_INVITACION=cambia-esto

# Clave para firmar la cookie "mantener la sesion" (texto largo y aleatorio)
APP_CLAVE_RECORDARME=cambia-esto
